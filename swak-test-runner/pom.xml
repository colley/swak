<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.gitee.mcolley</groupId>
        <artifactId>swak</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>swak-test-runner</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>swak 组件集成测试（自动配置加载、序列化契约、分页 SQL）</description>

    <properties>
        <!-- 仅用于测试，不发布 -->
        <skip_maven_deploy>true</skip_maven_deploy>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <curator.version>5.7.1</curator.version>
    </properties>

    <dependencies>
        <!-- 被测组件：都是 provided 依赖，需在此显式补齐 -->
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-datarchiver-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-distributed-lock-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-extcache-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-job-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-operatelog-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-license-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-license-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-formula</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 这些模块没有 starter 传递进来，但属于「全部组件」，需显式声明才会进聚合覆盖率 -->
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-i18n</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-excel-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-license-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gitee.mcolley</groupId>
            <artifactId>swak-dubbo</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 组件以 provided 声明的第三方依赖 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-recipes</artifactId>
            <version>${curator.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-redis</artifactId>
        </dependency>
        <!-- Nacos：swak-license-boot-starter 以 provided 声明，测试需要真实加载 NacosConfigManager -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 聚合所有被测模块的覆盖率，产出 target/site/jacoco-aggregate/ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- 口径：只考核自研业务代码。spectator/javatuples 是第三方移植，
                         dto/model 是纯数据载体，测它们只会稀释指标 -->
                    <excludes>
                        <exclude>com/swak/core/spectator/**</exclude>
                        <exclude>com/swak/common/tuple/**</exclude>
                        <exclude>com/swak/common/dto/**</exclude>
                        <exclude>com/swak/core/monitor/model/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 测试模块不产出 javadoc / sources / test-jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <configuration>
                    <skipSource>true</skipSource>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          覆盖率门禁：mvn verify -Pcoverage-gate
          默认不激活，避免达标前把日常构建打红；阈值可用 -Dcoverage.minimum=0.85 覆盖。
        -->
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>coverage-gate</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
